---
import MediaPlaceholder from './MediaPlaceholder.astro';
import { withBase } from '../lib/paths';
interface Props { title: string; description: string; media: string; }
const { title, description, media } = Astro.props;
---
<article class="activity-card"><MediaPlaceholder id={media} /><div class="card-body"><h3>{title}</h3><p>{description}</p><a class="text-link" href={withBase('/activities/', import.meta.env.BASE_URL)}>Explore this Pack tradition →</a></div></article>
