---
import { pack } from '../data/pack';
import { emailHref, published } from '../lib/content';
import { withBase } from '../lib/paths';
const href = emailHref(pack.contacts.shared);
const chair = pack.leaders.find(leader => leader.role === 'Committee Chair');
---
<div class="pack-contact">
  {href ? <><p><strong>{chair && published(chair.name)}</strong><br />Committee Chair</p><a class="contact-link" href={href}>{published(pack.contacts.shared)}</a><p>{pack.contacts.responseTime}</p></> : <>
    <p><strong>Shared Pack email</strong><br />Awaiting confirmation</p>
    <a class="text-link" href={withBase('/contact/', import.meta.env.BASE_URL)}>Pack contact details <span aria-hidden="true">→</span></a>
  </>}
</div>
