---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import JoinCTA from '../components/JoinCTA.astro';
import RankGrid from '../components/RankGrid.astro';
import FAQList from '../components/FAQList.astro';
import StatusCallout from '../components/StatusCallout.astro';
import ResourceGroup from '../components/ResourceGroup.astro';
import ButtonLink from '../components/ButtonLink.astro';
import PackContact from '../components/PackContact.astro';
import ActivityCard from '../components/ActivityCard.astro';
import { pack } from '../data/pack';
import { published, emailHref } from '../lib/content';
import { withBase } from '../lib/paths';
export async function getStaticPaths() { return (await getCollection('pages')).filter(page => !['home', 'calendar'].includes(page.id)).map(page => ({ params: { page: page.id }, props: { page } })); }
interface Props { page: CollectionEntry<'pages'>; }
const { page } = Astro.props;
const { Content, headings } = await render(page);
const id = page.id;
const extras = id === 'resources' ? [{ slug: 'scout-shop', text: 'Scout Shop' }, { slug: 'faq', text: 'Frequently asked questions' }] : id === 'about' ? [{ slug: 'dens', text: 'Dens and ranks' }] : [];
---
<BaseLayout title={page.data.title} description={page.data.description}>
  <Hero page={page} />
  <section class="section"><div class="container content-shell">
    <nav class="contents" aria-label="On this page"><h2>On this page</h2><ul>{[...headings.filter(h => h.depth === 2), ...extras].map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul><a href={withBase('/join/', import.meta.env.BASE_URL)}>Join Pack 862 →</a><a href={withBase('/contact/', import.meta.env.BASE_URL)}>Pack contact details →</a></nav>
    <div>
      {id === 'join' && <div class="actions inline-actions"><ButtonLink href={pack.links.youth}>Start youth registration ↗</ButtonLink><ButtonLink href="/contact/" variant="outline">Pack contact details</ButtonLink></div>}
      {id === 'contact' && <ResourceGroup id="shared-contact" title="Primary Pack contact"><PackContact /></ResourceGroup>}
      <div class="prose"><Content /></div>
      <div class="page-extras">
        {id === 'about' && <ResourceGroup id="dens" title="Find your Den"><RankGrid /></ResourceGroup>}
        {id === 'join' && <StatusCallout title="Financial assistance" value={pack.assistance} />}
        {id === 'resources' && <>
          <ResourceGroup id="scout-shop" title="LA Scout Shop"><p><strong>{pack.shop.name}</strong><br />{pack.shop.address}</p><StatusCallout value={pack.shop.hours} /></ResourceGroup>
          <ResourceGroup id="faq" title="Frequently asked questions"><FAQList /></ResourceGroup>
        </>}
        {id === 'contact' && <>{pack.leaders.filter(leader => published(leader.name)).map(leader => <ResourceGroup id={leader.role.toLowerCase().replaceAll(' ', '-')} title={leader.role}><StatusCallout value={leader.name} showStatus={false} />{emailHref(leader.email) && <a class="text-link" href={emailHref(leader.email)}>{published(leader.email)}</a>}</ResourceGroup>)}</>}
      </div>
    </div>
  </div></section>
  {id === 'activities' && <section class="section section--alt"><div class="container card-grid">{page.data.cards?.map(card => <ActivityCard {...card} />)}</div></section>}
  <JoinCTA />
</BaseLayout>
